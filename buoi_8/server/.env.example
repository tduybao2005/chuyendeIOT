# =========================================================================
# MAU CAU HINH SERVER - copy file nay thanh .env roi dien gia tri THAT
#
#     cp .env.example .env
#
# File .env da bi .gitignore chan (dong '.env*') nen khong bao gio len
# GitHub. File .env.example nay thi duoc commit, va vi vay TUYET DOI KHONG
# duoc dien gia tri that vao day.
# =========================================================================

# -------------------------------------------------------------------------
# 1. MONGODB ATLAS  (bat buoc)
#
# Lay chuoi nay o Atlas: Database > Connect > Drivers > Python.
# Nho THAY <db_password> bang mat khau that cua database user.
# Xem tung buoc trong HUONG_DAN_ATLAS.md.
#
# Mat khau co ky tu dac biet (@ : / ? # [ ] %) thi phai ma hoa URL, neu
# khong chuoi bi cat sai cho va bao loi kho hieu. Cach ma hoa:
#     python3 -c "import urllib.parse,sys; print(urllib.parse.quote_plus(sys.argv[1]))" 'mat_khau_cua_ban'
# Cach de nhat la dat mat khau chi gom chu va so.
# -------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority

# -------------------------------------------------------------------------
# 2. API_KEY  (bat buoc, toi thieu 16 ky tu)
#
# De bai muc do 3: "co ho tro bao mat dang API_KEY". Khoa nay phai TRUNG voi
# bien IOT_BUOI8_API_KEY dat tren Raspberry Pi.
#
# Tao mot khoa ngau nhien tot:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# -------------------------------------------------------------------------
API_KEY=dien-khoa-ngau-nhien-it-nhat-16-ky-tu-vao-day

# -------------------------------------------------------------------------
# 3. TUY CHON - co gia tri mac dinh san, khong dien cung chay duoc
# -------------------------------------------------------------------------
MONGODB_DB=iot_buoi8
MONGODB_COLLECTION=du_lieu_cam_bien

# 0.0.0.0 = lang nghe tren MOI card mang, nho vay Raspberry Pi o may khac
# goi toi duoc. Dat 127.0.0.1 thi CHI may chay server vao duoc - Pi se bao
# "Connection refused".
HOST=0.0.0.0
PORT=8000
