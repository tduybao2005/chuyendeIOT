        <mxCell id="1" parent="0" />

        <!-- L: note_sensor_fail() -->
        <mxCell id="ls0" value="note_sensor_fail()&#10;được gọi" style="terminator;whiteSpace=wrap;html=1;fillColor=#3a1616;strokeColor=#f87171;fontColor=#ffffff;fontSize=12" vertex="1" parent="1"><mxGeometry x="60" y="40" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="lp1" value="health['sensor_fail'] += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a1616;strokeColor=#f87171;fontColor=#ffffff;fontSize=11" vertex="1" parent="1"><mxGeometry x="60" y="150" width="220" height="70" as="geometry"/></mxCell>
