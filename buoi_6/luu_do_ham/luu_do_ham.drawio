        <mxCell id="lend" value="Kết thúc, chạy tiếp" style="terminator;whiteSpace=wrap;html=1;fillColor=#3a1616;strokeColor=#f87171;fontColor=#ffffff;fontSize=12" vertex="1" parent="1"><mxGeometry x="80" y="560" width="180" height="50" as="geometry"/></mxCell>

