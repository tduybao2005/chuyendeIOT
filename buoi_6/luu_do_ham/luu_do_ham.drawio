        <mxCell id="rd1" value="n ≥ 20?&#10;(NETWORK_FAIL_LIMIT)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3a3316;strokeColor=#fbbf24;fontColor=#ffffff;fontSize=11" vertex="1" parent="1"><mxGeometry x="630" y="390" width="240" height="110" as="geometry"/></mxCell>
