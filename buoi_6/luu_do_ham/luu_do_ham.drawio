        <mxCell id="rs0" value="note_network_fail()&#10;được gọi" style="terminator;whiteSpace=wrap;html=1;fillColor=#3a1616;strokeColor=#f87171;fontColor=#ffffff;fontSize=12" vertex="1" parent="1"><mxGeometry x="640" y="40" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="rp1" value="health['network_fail'] += 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3a1616;strokeColor=#f87171;fontColor=#ffffff;fontSize=11" vertex="1" parent="1"><mxGeometry x="640" y="150" width="220" height="70" as="geometry"/></mxCell>
