    "name": "Chuan bi lenh Mode (MQTT)",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst MQTT_CHANNEL_ID = \"DIEN_CHANNEL_ID_MQTT_CUA_BAN\";\nconst FIELD_MODE = 'field1';\n// ===========================================================================\nmsg.topic = `channels/${MQTT_CHANNEL_ID}/publish/fields/${FIELD_MODE}`;\nmsg.payload = (msg.payload === 'manual') ? '1' : '0';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
