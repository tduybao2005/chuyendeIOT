  {
    "id": "buoi5_mqtt_broker",
    "type": "mqtt-broker",
    "name": "ThingSpeak MQTT (kenh Mode)",
    "broker": "mqtt3.thingspeak.com",
    "port": "1883",
    "clientid": "DIEN_MQTT_CLIENT_ID_CUA_BAN",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "30",
    "cleansession": true,
    "birthTopic": "",
    "closeTopic": "",
    "willTopic": "",
    "sessionExpiry": "",
