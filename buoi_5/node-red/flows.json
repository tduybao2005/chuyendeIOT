    "id": "n_fn_prep_device_cmd",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Chuan bi lenh thiet bi (HTTP)",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_WRITE_API_KEY = \"DIEN_WRITE_API_KEY_CUA_BAN\";\nconst FIELD = { led: 'field5', buzzer: 'field6', relay: 'field7' };\n// ===========================================================================\nconst field = FIELD[msg.topic];\nif (!field) { node.warn('Topic lenh khong hop le: ' + msg.topic); return null; }\n\nmsg.url = 'https://api.thingspeak.com/update.json';\nmsg.method = 'POST';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = { api_key: THINGSPEAK_WRITE_API_KEY, [field]: msg.payload ? '1' : '0' };\nmsg.attempt = 1;\nreturn msg;",
