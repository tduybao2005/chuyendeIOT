  {
    "id": "n_inj_http",
    "type": "inject",
    "z": "buoi5_flow",
    "name": "Moi 15s: doc kenh HTTP",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "15",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "wires": [
      [
        "n_fn_prep_http"
      ]
    ]
  },
  {
    "id": "n_fn_prep_http",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Chuan bi URL doc kenh HTTP",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_CHANNEL_ID = \"DIEN_CHANNEL_ID_HTTP_CUA_BAN\";\nconst THINGSPEAK_READ_API_KEY = \"DIEN_READ_API_KEY_CUA_BAN\";\nconst HISTORY_RESULTS = 30;\n// ===========================================================================\nmsg.url = `https://api.thingspeak.com/channels/${THINGSPEAK_CHANNEL_ID}/feeds.json?api_key=${THINGSPEAK_READ_API_KEY}&results=${HISTORY_RESULTS}`;\nmsg.method = 'GET';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_http_http"
      ]
    ]
  },
  {
    "id": "n_http_http",
    "type": "http request",
    "z": "buoi5_flow",
    "name": "GET feeds.json (kenh HTTP)",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "n_fn_parse_http"
      ]
    ]
  },
  {
    "id": "n_fn_parse_http",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Xu ly du lieu HTTP -> http_data",
    "func": "const FIELD = { temp:'field1', humi:'field2', voltage:'field3', distance:'field4', led:'field5', buzzer:'field6', relay:'field7' };\n\nfunction toNumber(v) { if (v === undefined || v === null || v === '') return null; const n = Number(v); return Number.isNaN(n) ? null : n; }\nfunction toBool(v) { return toNumber(v) === 1; }\n\nconst feeds = (msg.payload && msg.payload.feeds) || [];\n\n// Moi lan ghi rieng le 1 field se tao 1 dong moi (cac field con lai null trong dong do).\n// Quet nguoc tu ban ghi moi nhat ve cu, lay gia tri KHONG null dau tien cho TUNG field.\nconst deviceState = { led: false, buzzer: false, relay: false };\nconst found = { led: false, buzzer: false, relay: false };\nfor (let i = feeds.length - 1; i >= 0 && !(found.led && found.buzzer && found.relay); i--) {\n  const f = feeds[i];\n  if (!found.led && f[FIELD.led] != null && f[FIELD.led] !== '') { deviceState.led = toBool(f[FIELD.led]); found.led = true; }\n  if (!found.buzzer && f[FIELD.buzzer] != null && f[FIELD.buzzer] !== '') { deviceState.buzzer = toBool(f[FIELD.buzzer]); found.buzzer = true; }\n  if (!found.relay && f[FIELD.relay] != null && f[FIELD.relay] !== '') { deviceState.relay = toBool(f[FIELD.relay]); found.relay = true; }\n}\n\nlet latest = { temp: null, humi: null, updatedAt: null };\nfor (let i = feeds.length - 1; i >= 0; i--) {\n  const f = feeds[i];\n  const temp = toNumber(f[FIELD.temp]);\n  const humi = toNumber(f[FIELD.humi]);\n  if (temp !== null || humi !== null) { latest = { temp, humi, updatedAt: f.created_at }; break; }\n}\n\nconst history = feeds\n  .map(f => ({ createdAt: f.created_at, temp: toNumber(f[FIELD.temp]), humi: toNumber(f[FIELD.humi]) }))\n  .filter(p => p.temp !== null || p.humi !== null);\n\nnode.status({ fill: 'green', shape: 'dot', text: 'OK ' + new Date().toLocaleTimeString('vi-VN') });\nmsg.payload = { type: 'http_data', history, latest, deviceState };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_ui_template"
      ]
    ]
  },
  {
    "id": "n_mqtt_in_mode",
    "type": "mqtt in",
    "z": "buoi5_flow",
    "name": "MQTT subscribe che do (kenh Mode)",
    "topic": "channels/DIEN_CHANNEL_ID_MQTT_CUA_BAN/subscribe",
    "qos": "0",
    "datatype": "utf8",
    "broker": "buoi5_mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "wires": [
      [
        "n_fn_parse_mode_mqtt"
      ]
    ]
  },
  {
    "id": "n_fn_parse_mode_mqtt",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Xu ly che do (MQTT) -> mode_update",
    "func": "// field \"Mode\" tren KENH MQTT RIENG nay chinh la field1 cua kenh nay\nconst FIELD_MODE = 'field1';\nlet data;\ntry {\n  data = JSON.parse(msg.payload);\n} catch (e) {\n  node.warn('Payload MQTT khong hop le: ' + e.message);\n  return null;\n}\nif (data[FIELD_MODE] === undefined || data[FIELD_MODE] === null) return null;\nconst mode = Number(data[FIELD_MODE]) === 1 ? 'manual' : 'auto';\nnode.status({ fill: 'blue', shape: 'dot', text: 'MQTT: ' + mode });\nmsg.payload = { type: 'mode_update', mode };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_ui_template"
      ]
    ]
  },
  {
    "id": "n_inj_mode_fb",
    "type": "inject",
    "z": "buoi5_flow",
    "name": "Moi 15s: doc che do du phong (HTTP)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "15",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "wires": [
