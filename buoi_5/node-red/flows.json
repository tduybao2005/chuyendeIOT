  {
    "id": "n_inj_http",
    "type": "inject",
    "z": "buoi5_flow",
    "name": "Moi 15s: doc kenh HTTP",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "15",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "wires": [
      [
        "n_fn_prep_http"
      ]
    ]
  },
  {
    "id": "n_fn_prep_http",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Chuan bi URL doc kenh HTTP",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_CHANNEL_ID = \"DIEN_CHANNEL_ID_HTTP_CUA_BAN\";\nconst THINGSPEAK_READ_API_KEY = \"DIEN_READ_API_KEY_CUA_BAN\";\nconst HISTORY_RESULTS = 30;\n// ===========================================================================\nmsg.url = `https://api.thingspeak.com/channels/${THINGSPEAK_CHANNEL_ID}/feeds.json?api_key=${THINGSPEAK_READ_API_KEY}&results=${HISTORY_RESULTS}`;\nmsg.method = 'GET';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_http_http"
      ]
    ]
  },
  {
    "id": "n_http_http",
    "type": "http request",
    "z": "buoi5_flow",
    "name": "GET feeds.json (kenh HTTP)",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "n_fn_parse_http"
      ]
    ]
  },
  {
    "id": "n_fn_parse_http",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Xu ly du lieu HTTP -> http_data",
    "func": "const FIELD = { temp:'field1', humi:'field2', voltage:'field3', distance:'field4', led:'field5', buzzer:'field6', relay:'field7' };\n\nfunction toNumber(v) { if (v === undefined || v === null || v === '') return null; const n = Number(v); return Number.isNaN(n) ? null : n; }\nfunction toBool(v) { return toNumber(v) === 1; }\n\nconst feeds = (msg.payload && msg.payload.feeds) || [];\n\n// Moi lan ghi rieng le 1 field se tao 1 dong moi (cac field con lai null trong dong do).\n// Quet nguoc tu ban ghi moi nhat ve cu, lay gia tri KHONG null dau tien cho TUNG field.\nconst deviceState = { led: false, buzzer: false, relay: false };\nconst found = { led: false, buzzer: false, relay: false };\nfor (let i = feeds.length - 1; i >= 0 && !(found.led && found.buzzer && found.relay); i--) {\n  const f = feeds[i];\n  if (!found.led && f[FIELD.led] != null && f[FIELD.led] !== '') { deviceState.led = toBool(f[FIELD.led]); found.led = true; }\n  if (!found.buzzer && f[FIELD.buzzer] != null && f[FIELD.buzzer] !== '') { deviceState.buzzer = toBool(f[FIELD.buzzer]); found.buzzer = true; }\n  if (!found.relay && f[FIELD.relay] != null && f[FIELD.relay] !== '') { deviceState.relay = toBool(f[FIELD.relay]); found.relay = true; }\n}\n\nlet latest = { temp: null, humi: null, updatedAt: null };\nfor (let i = feeds.length - 1; i >= 0; i--) {\n  const f = feeds[i];\n  const temp = toNumber(f[FIELD.temp]);\n  const humi = toNumber(f[FIELD.humi]);\n  if (temp !== null || humi !== null) { latest = { temp, humi, updatedAt: f.created_at }; break; }\n}\n\nconst history = feeds\n  .map(f => ({ createdAt: f.created_at, temp: toNumber(f[FIELD.temp]), humi: toNumber(f[FIELD.humi]) }))\n  .filter(p => p.temp !== null || p.humi !== null);\n\nnode.status({ fill: 'green', shape: 'dot', text: 'OK ' + new Date().toLocaleTimeString('vi-VN') });\nmsg.payload = { type: 'http_data', history, latest, deviceState };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_ui_template"
      ]
    ]
  },
  {
    "id": "n_mqtt_in_mode",
    "type": "mqtt in",
    "z": "buoi5_flow",
    "name": "MQTT subscribe che do (kenh Mode)",
    "topic": "channels/DIEN_CHANNEL_ID_MQTT_CUA_BAN/subscribe",
    "qos": "0",
    "datatype": "utf8",
    "broker": "buoi5_mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "wires": [
      [
        "n_fn_parse_mode_mqtt"
      ]
    ]
  },
  {
    "id": "n_fn_parse_mode_mqtt",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Xu ly che do (MQTT) -> mode_update",
    "func": "// field \"Mode\" tren KENH MQTT RIENG nay chinh la field1 cua kenh nay\nconst FIELD_MODE = 'field1';\nlet data;\ntry {\n  data = JSON.parse(msg.payload);\n} catch (e) {\n  node.warn('Payload MQTT khong hop le: ' + e.message);\n  return null;\n}\nif (data[FIELD_MODE] === undefined || data[FIELD_MODE] === null) return null;\nconst mode = Number(data[FIELD_MODE]) === 1 ? 'manual' : 'auto';\nnode.status({ fill: 'blue', shape: 'dot', text: 'MQTT: ' + mode });\nmsg.payload = { type: 'mode_update', mode };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_ui_template"
      ]
    ]
  },
  {
    "id": "n_inj_mode_fb",
    "type": "inject",
    "z": "buoi5_flow",
    "name": "Moi 15s: doc che do du phong (HTTP)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "15",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "wires": [
      [
        "n_fn_prep_mode_fb"
      ]
    ]
  },
  {
    "id": "n_fn_prep_mode_fb",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Chuan bi URL doc che do du phong",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst MQTT_CHANNEL_ID = \"DIEN_CHANNEL_ID_MQTT_CUA_BAN\";\nconst MQTT_CHANNEL_READ_API_KEY = \"DIEN_READ_API_KEY_CUA_KENH_MQTT_CUA_BAN\";\n// ===========================================================================\nmsg.url = `https://api.thingspeak.com/channels/${MQTT_CHANNEL_ID}/feeds.json?api_key=${MQTT_CHANNEL_READ_API_KEY}&results=10`;\nmsg.method = 'GET';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_http_mode_fb"
      ]
    ]
  },
  {
    "id": "n_http_mode_fb",
    "type": "http request",
    "z": "buoi5_flow",
    "name": "GET feeds.json (kenh Mode)",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "n_fn_parse_mode_fb"
      ]
    ]
  },
  {
    "id": "n_fn_parse_mode_fb",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Xu ly che do (du phong HTTP) -> mode_update",
    "func": "const FIELD_MODE = 'field1';\nfunction toNumber(v) { if (v === undefined || v === null || v === '') return null; const n = Number(v); return Number.isNaN(n) ? null : n; }\n\nconst feeds = (msg.payload && msg.payload.feeds) || [];\nfor (let i = feeds.length - 1; i >= 0; i--) {\n  const v = feeds[i][FIELD_MODE];\n  if (v !== undefined && v !== null && v !== '') {\n    const mode = toNumber(v) === 1 ? 'manual' : 'auto';\n    node.status({ fill: 'grey', shape: 'ring', text: 'HTTP: ' + mode });\n    msg.payload = { type: 'mode_update', mode };\n    return msg;\n  }\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_ui_template"
      ]
    ]
  },
  {
    "id": "n_ui_template",
    "type": "ui_template",
    "z": "buoi5_flow",
    "group": "buoi5_ui_group",
    "name": "Dashboard Buoi 5 (HTML tuy chinh)",
    "order": 1,
    "width": "6",
    "height": "0",
    "format": "<style>\n.nr-dashboard-theme .card-panel { background: transparent !important; box-shadow: none !important; }\n/* node-red-dashboard (ban AngularJS cu) bo widget (ui_template) trong 1\n   the <md-card class=\"nr-dashboard-template\"> co width co dinh theo don vi\n   pixel cua ui_group (KHONG tu dong gian het chieu rong man hinh). De\n   dashboard nay hien du toan bo noi dung tren moi kich thuoc man hinh, ep\n   toan bo chuoi container cha (card/cardpanel/cardcontainer) gian ra 100%\n   chieu rong cua khu vuc noi dung (masonry-container), thay vi bi ket cung\n   theo so don vi da khai bao tren ui_group. */\n.nr-dashboard-template.nr-dashboard-template,\n.nr-dashboard-cardcontainer, .nr-dashboard-cardpanel, ui-card-panel {\n  width: 100% !important; max-width: 100% !important; left: 0 !important;\n  position: relative !important; overflow: visible !important; height: auto !important;\n}\n#buoi5-root { box-sizing: border-box; font-family: -apple-system, Roboto, Arial, sans-serif; background:#F4F6F8; padding:12px; }\n#buoi5-root * { box-sizing: border-box; }\n#buoi5-root .title { font-size:20px; font-weight:700; text-align:center; margin-bottom:12px; color:#222; }\n#buoi5-root .grid { display:grid; grid-template-columns: 1fr; gap:12px; }\n@media (min-width: 700px) { #buoi5-root .grid { grid-template-columns: 1fr 1fr; } }\n#buoi5-root .card { background:#fff; border-radius:12px; padding:16px; }\n#buoi5-root .card.full { grid-column: 1 / -1; }\n#buoi5-root .card-title { font-size:13px; color:#777; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center; }\n#buoi5-root .dot { width:8px; height:8px; border-radius:4px; display:inline-block; margin-right:4px; }\n#buoi5-root .switch-row { display:flex; background:#F0F0F0; border-radius:10px; padding:4px; }\n#buoi5-root .switch-row button { flex:1; padding:10px; border:none; border-radius:8px; background:transparent; font-size:15px; font-weight:600; color:#666; cursor:pointer; }\n#buoi5-root .switch-row button.active { background:#1783B0; color:#fff; }\n#buoi5-root .clock { font-size:28px; font-weight:700; color:#1783B0; text-align:center; }\n#buoi5-root .clock-date { font-size:13px; color:#999; text-align:center; margin-top:2px; }\n#buoi5-root .reading-row { display:flex; justify-content:space-around; }\n#buoi5-root .reading-item { text-align:center; }\n#buoi5-root .reading-value { font-size:26px; font-weight:700; color:#222; }\n#buoi5-root .reading-label { font-size:12px; color:#999; margin-top:2px; }\n#buoi5-root .updated-at { font-size:12px; color:#999; margin-top:10px; text-align:center; }\n#buoi5-root .device-row { display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-bottom:1px solid #F0F0F0; }\n#buoi5-root .device-row:last-child { border-bottom:none; }\n#buoi5-root .device-left { display:flex; align-items:center; }\n#buoi5-root .device-left .icon { font-size:20px; margin-right:8px; }\n#buoi5-root .device-left .label { font-size:15px; font-weight:600; color:#333; }\n#buoi5-root .badge { padding:3px 8px; border-radius:10px; margin-right:10px; color:#fff; font-size:11px; font-weight:700; }\n#buoi5-root .badge.on { background:#4CAF50; }\n#buoi5-root .badge.off { background:#BDBDBD; }\n#buoi5-root .device-btn { background:#1783B0; color:#fff; border:none; border-radius:8px; padding:8px 14px; min-width:56px; font-weight:600; font-size:13px; cursor:pointer; }\n#buoi5-root .device-btn:disabled { background:#CCC; cursor:not-allowed; }\n#buoi5-root .legend { display:flex; margin-bottom:8px; }\n#buoi5-root .legend-item { display:flex; align-items:center; margin-right:16px; font-size:12px; color:#666; }\n#buoi5-root .legend-dot { width:8px; height:8px; border-radius:4px; margin-right:4px; }\n#buoi5-root svg.chart { width:100%; height:200px; display:block; }\n#buoi5-root .chart-axis { display:flex; justify-content:space-between; font-size:11px; color:#999; margin-top:4px; }\n#buoi5-root .chart-tooltip { font-size:12px; color:#333; background:#F4F6F8; border-radius:6px; padding:4px 8px; margin-top:6px; display:inline-block; }\n#buoi5-root .card-title span:last-child { font-weight:600; color:#555; }\n</style>\n\n<div id=\"buoi5-root\">\n  <div class=\"title\">Giám sát &amp; Điều khiển - Nhóm 3</div>\n  <div class=\"grid\">\n\n    <div class=\"card\">\n      <div class=\"card-title\">\n        <span>Chế độ hoạt động</span>\n        <span><span class=\"dot\" ng-style=\"{background: modeUpdatedRecently() ? '#4CAF50' : '#BDBDBD'}\"></span>Cập nhật lúc {{modeUpdatedAt || '--'}}</span>\n      </div>\n      <div class=\"switch-row\">\n        <button ng-class=\"{active: mode==='auto'}\" ng-click=\"setMode('auto')\">🤖 Auto</button>\n        <button ng-class=\"{active: mode==='manual'}\" ng-click=\"setMode('manual')\">✋ Manual</button>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">Thời gian hiện tại</div>\n      <div class=\"clock\">{{ clockStr }}</div>\n      <div class=\"clock-date\">{{ dateStr }}</div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">Giá trị mới nhất từ Server</div>\n      <div class=\"reading-row\">\n        <div class=\"reading-item\">\n          <div class=\"reading-value\">{{ latest.temp !== null ? latest.temp.toFixed(1) + '°C' : '--' }}</div>\n          <div class=\"reading-label\">Nhiệt độ</div>\n        </div>\n        <div class=\"reading-item\">\n          <div class=\"reading-value\">{{ latest.humi !== null ? latest.humi.toFixed(1) + '%' : '--' }}</div>\n          <div class=\"reading-label\">Độ ẩm</div>\n        </div>\n      </div>\n      <div class=\"updated-at\">Cập nhật lúc: {{ latest.updatedAt || '--' }}</div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"card-title\">Điều khiển thiết bị {{ mode !== 'manual' ? '(chỉ dùng được ở chế độ Manual)' : '' }}</div>\n      <div class=\"device-row\">\n        <div class=\"device-left\"><span class=\"icon\">💡</span><span class=\"label\">LED</span></div>\n        <div>\n          <span class=\"badge\" ng-class=\"device.led ? 'on' : 'off'\">{{ device.led ? 'ON' : 'OFF' }}</span>\n          <button class=\"device-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"toggleDevice('led')\">{{ device.led ? 'Tắt' : 'Bật' }}</button>\n        </div>\n      </div>\n      <div class=\"device-row\">\n        <div class=\"device-left\"><span class=\"icon\">🔊</span><span class=\"label\">Buzzer</span></div>\n        <div>\n          <span class=\"badge\" ng-class=\"device.buzzer ? 'on' : 'off'\">{{ device.buzzer ? 'ON' : 'OFF' }}</span>\n          <button class=\"device-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"toggleDevice('buzzer')\">{{ device.buzzer ? 'Tắt' : 'Bật' }}</button>\n        </div>\n      </div>\n      <div class=\"device-row\">\n        <div class=\"device-left\"><span class=\"icon\">🔌</span><span class=\"label\">Relay</span></div>\n        <div>\n          <span class=\"badge\" ng-class=\"device.relay ? 'on' : 'off'\">{{ device.relay ? 'ON' : 'OFF' }}</span>\n          <button class=\"device-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"toggleDevice('relay')\">{{ device.relay ? 'Tắt' : 'Bật' }}</button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"card full\">\n      <div class=\"card-title\">\n        <span><span class=\"legend-dot\" style=\"background:#E53935\"></span>Nhiệt độ (°C)</span>\n        <span ng-if=\"tempMin !== null\">Nhỏ nhất-lớn nhất: {{ tempMin.toFixed(1) }} - {{ tempMax.toFixed(1) }}</span>\n      </div>\n      <svg class=\"chart\" ng-attr-viewbox=\"0 0 {{chartWidth}} 160\">\n        <line ng-repeat=\"g in tempGrid\" ng-attr-x1=\"36\" ng-attr-y1=\"{{g.y}}\" ng-attr-x2=\"{{chartWidth-10}}\" ng-attr-y2=\"{{g.y}}\" stroke=\"#EEE\" stroke-width=\"1\"></line>\n        <text ng-repeat=\"g in tempGrid\" x=\"2\" ng-attr-y=\"{{g.textY}}\" font-size=\"10\" fill=\"#999\">{{ g.label }}</text>\n        <polyline ng-attr-points=\"{{ tempPolyline }}\" fill=\"none\" stroke=\"#E53935\" stroke-width=\"2\"></polyline>\n        <circle ng-repeat=\"p in tempPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"8\" fill=\"transparent\" style=\"cursor:pointer\" data-chart-key=\"temp\" ng-attr-data-chart-idx=\"{{$index}}\"></circle>\n        <circle ng-repeat=\"p in tempPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"2.5\" fill=\"#E53935\" style=\"pointer-events:none\"></circle>\n        <circle ng-if=\"selected.temp\" ng-attr-cx=\"{{selected.temp.x}}\" ng-attr-cy=\"{{selected.temp.y}}\" r=\"5.5\" fill=\"#E53935\" stroke=\"#fff\" stroke-width=\"2\" style=\"pointer-events:none\"></circle>\n      </svg>\n      <div class=\"chart-tooltip\" ng-if=\"selected.temp\">📍 {{ selected.temp.value.toFixed(1) }}°C lúc {{ selected.temp.time }}</div>\n      <div class=\"chart-axis\" ng-if=\"history.length>0\"><span>{{ chartFirstTime }}</span><span>{{ chartLastTime }}</span></div>\n      <div ng-if=\"history.length===0\" style=\"text-align:center;color:#999;padding:30px 0;\">Chưa có dữ liệu</div>\n    </div>\n\n    <div class=\"card full\">\n      <div class=\"card-title\">\n        <span><span class=\"legend-dot\" style=\"background:#1E88E5\"></span>Độ ẩm (%)</span>\n        <span ng-if=\"humiMin !== null\">Nhỏ nhất-lớn nhất: {{ humiMin.toFixed(1) }} - {{ humiMax.toFixed(1) }}</span>\n      </div>\n      <svg class=\"chart\" ng-attr-viewbox=\"0 0 {{chartWidth}} 160\">\n        <line ng-repeat=\"g in humiGrid\" ng-attr-x1=\"36\" ng-attr-y1=\"{{g.y}}\" ng-attr-x2=\"{{chartWidth-10}}\" ng-attr-y2=\"{{g.y}}\" stroke=\"#EEE\" stroke-width=\"1\"></line>\n        <text ng-repeat=\"g in humiGrid\" x=\"2\" ng-attr-y=\"{{g.textY}}\" font-size=\"10\" fill=\"#999\">{{ g.label }}</text>\n        <polyline ng-attr-points=\"{{ humiPolyline }}\" fill=\"none\" stroke=\"#1E88E5\" stroke-width=\"2\"></polyline>\n        <circle ng-repeat=\"p in humiPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"8\" fill=\"transparent\" style=\"cursor:pointer\" data-chart-key=\"humi\" ng-attr-data-chart-idx=\"{{$index}}\"></circle>\n        <circle ng-repeat=\"p in humiPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"2.5\" fill=\"#1E88E5\" style=\"pointer-events:none\"></circle>\n        <circle ng-if=\"selected.humi\" ng-attr-cx=\"{{selected.humi.x}}\" ng-attr-cy=\"{{selected.humi.y}}\" r=\"5.5\" fill=\"#1E88E5\" stroke=\"#fff\" stroke-width=\"2\" style=\"pointer-events:none\"></circle>\n      </svg>\n      <div class=\"chart-tooltip\" ng-if=\"selected.humi\">📍 {{ selected.humi.value.toFixed(1) }}% lúc {{ selected.humi.time }}</div>\n      <div class=\"chart-axis\" ng-if=\"history.length>0\"><span>{{ chartFirstTime }}</span><span>{{ chartLastTime }}</span></div>\n      <div ng-if=\"history.length===0\" style=\"text-align:center;color:#999;padding:30px 0;\">Chưa có dữ liệu</div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function(scope) {\n  scope.mode = 'auto';\n  scope.modeUpdatedAt = null;\n  scope.device = { led: false, buzzer: false, relay: false };\n  scope.latest = { temp: null, humi: null, updatedAt: null };\n  scope.history = [];\n  scope.chartWidth = 800;\n  scope.tempPolyline = ''; scope.humiPolyline = '';\n  scope.tempMin = null; scope.tempMax = null;\n  scope.humiMin = null; scope.humiMax = null;\n  scope.tempPoints = []; scope.humiPoints = [];\n  scope.tempGrid = []; scope.humiGrid = [];\n  scope.selected = { temp: null, humi: null };\n  scope.chartFirstTime = ''; scope.chartLastTime = '';\n  scope.clockStr = '';\n  scope.dateStr = '';\n\n  scope.selectPoint = function(key, p) {\n    scope.selected[key] = p;\n  };\n\n  // LUU Y: khong dung ng-click tren cac diem SVG vi AngularJS Material\n  // (dashboard nay dang dung) xung dot voi module ngTouch, khien ng-click\n  // tren phan tu SVG khong kich hoat duoc (da kiem chung: goi truc tiep\n  // scope.selectPoint() qua scope hoat dong dung 100%, nhung click that\n  // qua chuot/cham khong lam gi ca). Bat click bang addEventListener\n  // native + uy quyen (delegation) tren #buoi5-root - phan tu goc nay\n  // luon ton tai xuyen suot cac lan ve lai bieu do, nen khong lo bi mat\n  // listener khi ng-repeat tao lai node.\n  var root = document.getElementById('buoi5-root');\n  if (root) {\n    root.addEventListener('click', function(ev) {\n      var t = ev.target;\n      if (!t || t.tagName !== 'circle') return;\n      var key = t.getAttribute('data-chart-key');\n      if (!key) return;\n      var idx = parseInt(t.getAttribute('data-chart-idx'), 10);\n      var arr = key === 'temp' ? scope.tempPoints : scope.humiPoints;\n      var p = arr && arr[idx];\n      if (!p) return;\n      scope.$apply(function() { scope.selectPoint(key, p); });\n    });\n  }\n\n  var lastModeMsgTime = 0;\n  scope.modeUpdatedRecently = function() {\n    return (Date.now() - lastModeMsgTime) < 20000;\n  };\n\n  function tick() {\n    var now = new Date();\n    scope.clockStr = now.toLocaleTimeString('vi-VN', { hour12: false });\n    scope.dateStr = now.toLocaleDateString('vi-VN');\n  }\n  tick();\n  setInterval(function() { scope.$apply(tick); }, 1000);\n\n  // Moi duong (nhiet do / do am) co bieu do RIENG, tu chuan hoa theo\n  // min-max CUA CHINH NO (2 dai gia tri do C va % khac nhau hoan toan).\n  // Tra ve them: danh sach diem {x,y,value,time} de nguoi dung bam vao\n  // xem gia tri cu the, va 3 moc luoi (nho nhat/giua/lon nhat) de doc\n  // truc gia tri ma khong can bam.\n  function buildSeries(values, times) {\n    var w = scope.chartWidth, h = 160;\n    var padTop = 14, padBottom = 14, padLeft = 36, padRight = 10;\n    var plotW = w - padLeft - padRight, plotH = h - padTop - padBottom;\n    var idxs = [], vals = [];\n    for (var i = 0; i < values.length; i++) {\n      if (values[i] !== null && values[i] !== undefined) { idxs.push(i); vals.push(values[i]); }\n    }\n    if (vals.length === 0) return { points: '', min: null, max: null, pts: [], grid: [] };\n    var min = Math.min.apply(null, vals), max = Math.max.apply(null, vals);\n    if (min === max) { min -= 1; max += 1; } // tranh chia cho 0 khi chi co 1 gia tri / gia tri deu nhau\n    var range = max - min;\n    var n = values.length;\n    var pts = [];\n    var svgPts = [];\n    for (var k = 0; k < idxs.length; k++) {\n      var i2 = idxs[k], v = values[i2];\n      var x = padLeft + (n <= 1 ? 0 : (i2 / (n - 1)) * plotW);\n      var y = padTop + plotH - ((v - min) / range) * plotH;\n      pts.push({ x: x.toFixed(1), y: y.toFixed(1), value: v, time: formatChartTime(times[i2]) });\n      svgPts.push(x.toFixed(1) + ',' + y.toFixed(1));\n    }\n    var grid = [];\n    [min, (min + max) / 2, max].forEach(function(v) {\n      var y = padTop + plotH - ((v - min) / range) * plotH;\n      grid.push({ y: y.toFixed(1), textY: (y + 3.5).toFixed(1), label: v.toFixed(1) });\n    });\n    return { points: svgPts.join(' '), min: min, max: max, pts: pts, grid: grid };\n  }\n\n  function formatChartTime(iso) {\n    if (!iso) return '';\n    try { return new Date(iso).toLocaleTimeString('vi-VN', { hour12: false }); }\n    catch (e) { return ''; }\n  }\n\n  function redrawChart() {\n    var times = scope.history.map(function(p) { return p.createdAt; });\n    var t = buildSeries(scope.history.map(function(p) { return p.temp; }), times);\n    var h = buildSeries(scope.history.map(function(p) { return p.humi; }), times);\n    scope.tempPolyline = t.points; scope.tempMin = t.min; scope.tempMax = t.max;\n    scope.tempPoints = t.pts; scope.tempGrid = t.grid;\n    scope.humiPolyline = h.points; scope.humiMin = h.min; scope.humiMax = h.max;\n    scope.humiPoints = h.pts; scope.humiGrid = h.grid;\n    if (scope.history.length > 0) {\n      scope.chartFirstTime = formatChartTime(scope.history[0].createdAt);\n      scope.chartLastTime = formatChartTime(scope.history[scope.history.length - 1].createdAt);\n    }\n    // Bo lua chon cu vi toa do da tinh lai theo du lieu moi, giu lai se\n    // hien sai vi tri - nguoi dung bam lai la thay ngay.\n    scope.selected.temp = null;\n    scope.selected.humi = null;\n  }\n\n  scope.setMode = function(next) {\n    scope.mode = next; // phan hoi lac quan, se duoc xac nhan lai qua msg tiep theo\n    scope.send({ topic: 'mode', payload: next });\n  };\n\n  scope.toggleDevice = function(key) {\n    if (scope.mode !== 'manual') return;\n    var next = !scope.device[key];\n    scope.device[key] = next; // phan hoi lac quan\n    scope.send({ topic: key, payload: next });\n  };\n\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.payload) return;\n    var p = msg.payload;\n    if (p.type === 'http_data') {\n      scope.history = p.history || [];\n      scope.latest = p.latest || scope.latest;\n      scope.device = p.deviceState || scope.device;\n      redrawChart();\n    } else if (p.type === 'mode_update') {\n      scope.mode = p.mode;\n      scope.modeUpdatedAt = new Date().toLocaleTimeString('vi-VN', { hour12: false });\n      lastModeMsgTime = Date.now();\n    }\n  });\n})(scope);\n</script>\n",
    "storeOutMessages": true,
