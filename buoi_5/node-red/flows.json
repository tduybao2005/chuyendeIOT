  {
    "id": "n_fn_check_device_cmd",
    "type": "function",
    "z": "buoi5_flow",
    "name": "Kiem tra ket qua, tu thu lai (toi da 3 lan / 3s)",
    "func": "// ThingSpeak gioi han toi thieu 15s giua 2 lan ghi len CUNG 1 channel (channel\n// nay cung duoc Raspberry Pi ghi trung binh cam bien moi 20s, nen co the trung\n// nhip) - khi bi tu choi, tra ve HTTP 200 kem noi dung \"0\" (khong phai loi HTTP),\n// nen phai kiem tra entry_id thay vi chi dua vao ma trang thai HTTP.\nconst MAX_ATTEMPTS = 3;\nconst ok = msg.payload && typeof msg.payload === 'object' && Number(msg.payload.entry_id) > 0;\n\nif (ok) {\n  node.status({ fill: 'green', shape: 'dot', text: 'OK ' + new Date().toLocaleTimeString('vi-VN') });\n  return [msg, null];\n}\nif (msg.attempt < MAX_ATTEMPTS) {\n  node.warn(`Gui lenh dieu khien loi (lan ${msg.attempt}), thu lai sau 3s...`);\n  node.status({ fill: 'yellow', shape: 'ring', text: 'Thu lai lan ' + (msg.attempt + 1) });\n  msg.attempt += 1;\n  return [null, msg];\n}\nnode.status({ fill: 'red', shape: 'ring', text: 'That bai sau ' + MAX_ATTEMPTS + ' lan' });\nnode.warn('Gui lenh dieu khien that bai sau nhieu lan thu (co the do gioi han 15s/lan ghi cua ThingSpeak)');\nreturn [null, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
