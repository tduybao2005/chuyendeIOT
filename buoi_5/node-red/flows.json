    "clientid": "DIEN_MQTT_CLIENT_ID_CUA_BAN",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "30",
    "cleansession": true,
    "birthTopic": "",
    "closeTopic": "",
    "willTopic": "",
    "sessionExpiry": "",
