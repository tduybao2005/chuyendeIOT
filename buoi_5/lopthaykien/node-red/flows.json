  {
    "id": "n_inj_http",
    "type": "inject",
    "z": "bk5_flow",
    "name": "Moi 15s: doc du lieu (HTTP)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "15",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
