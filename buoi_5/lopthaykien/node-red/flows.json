  {
    "id": "n_fn_prep_http_cmd",
    "type": "function",
    "z": "bk5_flow",
    "name": "Chuan bi lenh HTTP (LED Tat/Buzzer Tat/Relay Bat/Tat)",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_WRITE_API_KEY = \"DIEN_WRITE_API_KEY_CUA_BAN\";\n// field5 = LED, field7 = Relay, field8 = Buzzer\nconst TOPIC_MAP = {\n  led_off:    { field: 'field5', value: '0' },\n  buzzer_off: { field: 'field8', value: '0' },\n  relay_on:   { field: 'field7', value: '1' },\n  relay_off:  { field: 'field7', value: '0' },\n};\n// ===========================================================================\nconst cfg = TOPIC_MAP[msg.topic];\nif (!cfg) { node.warn('Topic HTTP khong hop le: ' + msg.topic); return null; }\n\nmsg.url = 'https://api.thingspeak.com/update.json';\nmsg.method = 'POST';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = { api_key: THINGSPEAK_WRITE_API_KEY, [cfg.field]: cfg.value };\nmsg.attempt = 1;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_http_device_cmd"
      ]
    ]
  },
  {
    "id": "n_http_device_cmd",
    "type": "http request",
    "z": "bk5_flow",
    "name": "POST update.json (lenh HTTP)",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
