  {
    "id": "n_fn_prep_mqtt_cmd",
    "type": "function",
    "z": "bk5_flow",
    "name": "Chuan bi lenh MQTT (Auto/Manual/LED Bat/Buzzer Bat)",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_CHANNEL_ID = \"DIEN_CHANNEL_ID_CUA_BAN\";\n// field6 = Che do (0=Auto,1=Manual), field5 = LED, field8 = Buzzer\nconst TOPIC_MAP = {\n  auto:       { field: 'field6', value: '0' },\n  manual:     { field: 'field6', value: '1' },\n  led_on:     { field: 'field5', value: '1' },\n  buzzer_on:  { field: 'field8', value: '1' },\n};\n// ===========================================================================\nconst cfg = TOPIC_MAP[msg.topic];\nif (!cfg) { node.warn('Topic MQTT khong hop le: ' + msg.topic); return null; }\nmsg.topic = `channels/${THINGSPEAK_CHANNEL_ID}/publish/fields/${cfg.field}`;\nmsg.payload = cfg.value;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_mqtt_out_cmd"
      ]
    ]
  },
  {
    "id": "n_mqtt_out_cmd",
    "type": "mqtt out",
    "z": "bk5_flow",
    "name": "MQTT publish (Auto/Manual/LED Bat/Buzzer Bat)",
    "topic": "",
    "qos": "1",
    "retain": "true",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
