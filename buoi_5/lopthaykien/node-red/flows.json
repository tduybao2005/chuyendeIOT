      ]
    ]
  },
  {
    "id": "n_fn_prep_http",
    "type": "function",
    "z": "bk5_flow",
    "name": "Chuan bi URL doc kenh (HTTP)",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_CHANNEL_ID = \"DIEN_CHANNEL_ID_CUA_BAN\";\nconst THINGSPEAK_READ_API_KEY = \"DIEN_READ_API_KEY_CUA_BAN\";\nconst HISTORY_RESULTS = 30;\n// ===========================================================================\nmsg.url = `https://api.thingspeak.com/channels/${THINGSPEAK_CHANNEL_ID}/feeds.json?api_key=${THINGSPEAK_READ_API_KEY}&results=${HISTORY_RESULTS}`;\nmsg.method = 'GET';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_http_http"
      ]
    ]
  },
  {
    "id": "n_http_http",
    "type": "http request",
    "z": "bk5_flow",
    "name": "GET feeds.json (1 channel)",
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "wires": [
      [
        "n_fn_parse_http"
      ]
    ]
  },
  {
    "id": "n_fn_parse_http",
    "type": "function",
    "z": "bk5_flow",
    "name": "Xu ly du lieu HTTP -> http_data",
    "func": "// Thu tu field: Nhiet do, Do am, Khoang cach, Dien ap, LED, Che do, Relay, Buzzer\nconst FIELD = { temp:'field1', humi:'field2', distance:'field3', voltage:'field4',\n                led:'field5', mode:'field6', relay:'field7', buzzer:'field8' };\n\nfunction toNumber(v) { if (v === undefined || v === null || v === '') return null; const n = Number(v); return Number.isNaN(n) ? null : n; }\nfunction toBool(v) { return toNumber(v) === 1; }\n\nconst feeds = (msg.payload && msg.payload.feeds) || [];\n\n// Moi lan ghi rieng le 1 field se tao 1 dong moi (cac field con lai cua dong\n// do la null). Quet nguoc tu ban ghi moi nhat ve cu, lay gia tri KHONG null\n// dau tien cho TUNG field dieu khien rieng biet.\nconst deviceState = { led: false, buzzer: false, relay: false };\nlet mode = 'auto';\nconst found = { led: false, buzzer: false, relay: false, mode: false };\nfor (let i = feeds.length - 1; i >= 0 && !(found.led && found.buzzer && found.relay && found.mode); i--) {\n  const f = feeds[i];\n  if (!found.led && f[FIELD.led] != null && f[FIELD.led] !== '') { deviceState.led = toBool(f[FIELD.led]); found.led = true; }\n  if (!found.buzzer && f[FIELD.buzzer] != null && f[FIELD.buzzer] !== '') { deviceState.buzzer = toBool(f[FIELD.buzzer]); found.buzzer = true; }\n  if (!found.relay && f[FIELD.relay] != null && f[FIELD.relay] !== '') { deviceState.relay = toBool(f[FIELD.relay]); found.relay = true; }\n  if (!found.mode && f[FIELD.mode] != null && f[FIELD.mode] !== '') { mode = toBool(f[FIELD.mode]) ? 'manual' : 'auto'; found.mode = true; }\n}\n\nlet latest = { temp: null, humi: null, voltage: null, distance: null, updatedAt: null };\nfor (let i = feeds.length - 1; i >= 0; i--) {\n  const f = feeds[i];\n  const temp = toNumber(f[FIELD.temp]);\n  const humi = toNumber(f[FIELD.humi]);\n  const voltage = toNumber(f[FIELD.voltage]);\n  const distance = toNumber(f[FIELD.distance]);\n  if (temp !== null || humi !== null || voltage !== null || distance !== null) {\n    latest = { temp, humi, voltage, distance, updatedAt: f.created_at };\n    break;\n  }\n}\n\nconst history = feeds\n  .map(f => ({ createdAt: f.created_at, temp: toNumber(f[FIELD.temp]), humi: toNumber(f[FIELD.humi]) }))\n  .filter(p => p.temp !== null || p.humi !== null);\n\nnode.status({ fill: 'green', shape: 'dot', text: 'OK ' + new Date().toLocaleTimeString('vi-VN') });\nmsg.payload = { type: 'http_data', history, latest, deviceState, mode };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_ui_template"
      ]
    ]
  },
  {
    "id": "n_ui_template",
    "type": "ui_template",
    "z": "bk5_flow",
    "group": "bk5_ui_group",
    "name": "Dashboard Buoi 5 (HTML tuy chinh)",
    "order": 1,
    "width": "6",
    "height": "0",
    "format": "<style>\n.nr-dashboard-theme .card-panel { background: transparent !important; box-shadow: none !important; }\n/* node-red-dashboard (ban AngularJS cu) bo widget (ui_template) trong 1\n   the <md-card class=\"nr-dashboard-template\"> co width co dinh theo don vi\n   pixel cua ui_group (KHONG tu dong gian het chieu rong man hinh). Ep toan\n   bo chuoi container cha gian ra 100% de dashboard hien du tren moi kich\n   thuoc man hinh (may tinh / dien thoai / ipad), va ep vung noi dung cuon\n   cua node-red-dashboard (md-content) khop dung 1 man hinh, khong cuon -\n   yeu cau de bai: \"Giao dien tren ipad co thanh cuon se bi tru 2 Diem\". */\n.nr-dashboard-template.nr-dashboard-template,\n.nr-dashboard-cardcontainer, .nr-dashboard-cardpanel, ui-card-panel,\n.masonry-container {\n  width: 100% !important; max-width: 100% !important; left: 0 !important;\n  position: relative !important; overflow: hidden !important; height: 100% !important;\n  padding: 0 !important; margin: 0 !important;\n}\nmd-content.nr-dashboard-theme, md-content._md { overflow: hidden !important; height: 100% !important; }\n/* Node-RED tu dong them 1 dong tieu de ten group (\"Giam sat & Dieu khien\")\n   phia tren widget - an di vi dashboard da co tieu de rieng, va de #bk-root\n   height:100% khop dung 1 man hinh (khong bi thua ra phan cao cua dong nay\n   gay tran/cuon). */\n.nr-dashboard-cardtitle { display: none !important; }\n/* Ban than khung ui_group/masonry cua node-red-dashboard tu tinh chieu cao\n   theo NOI DUNG (thu vien masonry dat height bang JS), khong the ep bang\n   100% CSS thong thuong (vong lap phu thuoc). Vi vay #bk-root dung\n   position:fixed neo ca 4 canh vao dung VIEWPORT that su, tach hoan toan\n   khoi cach masonry tinh kich thuoc - dam bao luon dung 1 man hinh du noi\n   dung cardpanel phia sau co cao hon. */\n#bk-root {\n  position: fixed; top: 0; left: 0; right: 0; bottom: 0;\n  box-sizing: border-box; font-family: -apple-system, Roboto, Arial, sans-serif;\n  background:#F4F6F8; padding: 1vh 1vw 2vh; z-index: 5;\n  display: flex; flex-direction: column; gap: 1vh; overflow: hidden;\n}\n#bk-root * { box-sizing: border-box; min-width: 0; min-height: 0; }\n#bk-root .title { font-size: clamp(12px, 2.2vh, 18px); font-weight:700; text-align:center; color:#222; flex: 0 0 auto; }\n#bk-root .card { background:#fff; border-radius:10px; padding: 1vh 1vw; }\n#bk-root .mini-title { font-size: clamp(9px, 1.3vh, 12px); color:#888; margin-bottom: 0.5vh; }\n\n#bk-root .top-row { display:flex; gap: 1vw; flex: 0 0 auto; }\n#bk-root .top-row .card { flex:1; }\n\n#bk-root .switch-row { display:flex; background:#F0F0F0; border-radius:8px; padding:3px; gap:3px; }\n#bk-root .switch-row button { flex:1; padding: 0.8vh 2px; border:none; border-radius:6px; background:transparent; font-size: clamp(10px, 1.6vh, 14px); font-weight:600; color:#666; cursor:pointer; white-space: nowrap; }\n@media (max-width: 480px) {\n  #bk-root .switch-row button { font-size: 11px; }\n  #bk-root .mini-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n}\n#bk-root .switch-row button.active { background:#1783B0; color:#fff; }\n\n#bk-root .clock { font-size: clamp(16px, 3vh, 26px); font-weight:700; color:#1783B0; text-align:center; line-height:1.1; }\n#bk-root .clock-date { font-size: clamp(9px, 1.3vh, 12px); color:#999; text-align:center; }\n\n#bk-root .sensor-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 0.3vh 6px; }\n#bk-root .sensor-grid .v { font-size: clamp(11px, 1.9vh, 15px); font-weight:700; color:#222; }\n#bk-root .sensor-grid .l { font-size: clamp(8px, 1.1vh, 10px); color:#999; }\n\n#bk-root .device-card { flex: 0 0 auto; }\n#bk-root .device-line { display:flex; align-items:center; gap: 0.8vw; padding: 0.5vh 0; }\n#bk-root .device-line .icon { font-size: clamp(12px, 2vh, 16px); width: 1.4em; text-align:center; }\n#bk-root .device-line .label { font-size: clamp(10px, 1.6vh, 13px); font-weight:600; color:#333; width: 4.5em; }\n#bk-root .badge { padding: 1px 6px; border-radius:8px; color:#fff; font-size: clamp(8px, 1.1vh, 10px); font-weight:700; }\n#bk-root .badge.on { background:#4CAF50; }\n#bk-root .badge.off { background:#BDBDBD; }\n#bk-root .btn-row { flex: 0 0 auto; margin-left:auto; display:flex; gap: 0.5vw; }\n#bk-root .device-btn { width: clamp(52px, 8vw, 80px); background:#1783B0; color:#fff; border:none; border-radius:16px; padding: 0.6vh 4px; font-weight:600; font-size: clamp(9px, 1.4vh, 12px); cursor:pointer; }\n#bk-root .device-btn.off-btn { background:#E0E0E0; color:#666; }\n#bk-root .device-btn:disabled { background:#EEE; color:#BBB; cursor:not-allowed; }\n\n#bk-root .charts-row { flex: 1 1 auto; display:flex; gap: 1vw; overflow:hidden; }\n#bk-root .chart-card { flex:1; display:flex; flex-direction:column; overflow:hidden; }\n#bk-root .chart-head { font-size: clamp(9px, 1.3vh, 12px); display:flex; justify-content:space-between; align-items:center; margin-bottom: 0.3vh; flex: 0 0 auto; }\n#bk-root .legend-dot { width:7px; height:7px; border-radius:4px; display:inline-block; margin-right:3px; }\n#bk-root .chart-wrap { flex: 1 1 auto; position:relative; min-height:0; }\n#bk-root svg.chart { width:100%; height:100%; display:block; }\n#bk-root .chart-axis { display:flex; justify-content:space-between; font-size: clamp(8px, 1vh, 10px); color:#999; flex: 0 0 auto; }\n/* Tooltip hien ngay canh diem vua bam (toa do tinh theo pixel that cua\n   khung ve) de de doi chieu, thay vi nam co dinh o goc. */\n#bk-root .chart-tooltip {\n  position:absolute; width:118px; text-align:center; pointer-events:none;\n  font-size: clamp(9px, 1.2vh, 11px); font-weight:600; color:#fff;\n  background:rgba(38,50,56,.92); border-radius:6px; padding:3px 4px;\n  box-shadow:0 1px 4px rgba(0,0,0,.25);\n}\n#bk-root .chart-hint { position:absolute; left:38px; bottom:2px; font-size: clamp(8px, 1vh, 10px); color:#BBB; pointer-events:none; }\n</style>\n\n<div id=\"bk-root\">\n  <div class=\"title\">Giám sát &amp; Điều khiển - Nhóm 7</div>\n\n  <div class=\"top-row\">\n    <div class=\"card\">\n      <div class=\"mini-title\">Chế độ hoạt động</div>\n      <div class=\"switch-row\">\n        <button ng-class=\"{active: mode==='auto'}\" ng-click=\"doAuto()\">🤖 Auto</button>\n        <button ng-class=\"{active: mode==='manual'}\" ng-click=\"doManual()\">✋ Manual</button>\n      </div>\n    </div>\n    <div class=\"card\">\n      <div class=\"mini-title\">Thời gian hiện tại</div>\n      <div class=\"clock\">{{ clockStr }}</div>\n      <div class=\"clock-date\">{{ dateStr }}</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"mini-title\">Giá trị mới nhất từ Server</div>\n      <div class=\"sensor-grid\">\n        <div><div class=\"v\">{{ latest.temp !== null ? latest.temp.toFixed(1) + '°C' : '--' }}</div><div class=\"l\">Nhiệt độ</div></div>\n        <div><div class=\"v\">{{ latest.humi !== null ? latest.humi.toFixed(1) + '%' : '--' }}</div><div class=\"l\">Độ ẩm</div></div>\n        <div><div class=\"v\">{{ latest.voltage !== null ? latest.voltage.toFixed(2) + 'V' : '--' }}</div><div class=\"l\">Điện áp</div></div>\n        <div><div class=\"v\">{{ latest.distance !== null ? latest.distance.toFixed(1) + 'cm' : '--' }}</div><div class=\"l\">Khoảng cách</div></div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"card device-card\">\n    <div class=\"mini-title\">Điều khiển thiết bị {{ mode !== 'manual' ? '(chỉ dùng được ở chế độ Manual)' : '' }}</div>\n    <div class=\"device-line\">\n      <span class=\"icon\">💡</span><span class=\"label\">LED</span>\n      <span class=\"badge\" ng-class=\"device.led ? 'on' : 'off'\">{{ device.led ? 'ON' : 'OFF' }}</span>\n      <div class=\"btn-row\">\n        <button class=\"device-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"doLedOn()\">Bật</button>\n        <button class=\"device-btn off-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"doLedOff()\">Tắt</button>\n      </div>\n    </div>\n    <div class=\"device-line\">\n      <span class=\"icon\">🔊</span><span class=\"label\">Buzzer</span>\n      <span class=\"badge\" ng-class=\"device.buzzer ? 'on' : 'off'\">{{ device.buzzer ? 'ON' : 'OFF' }}</span>\n      <div class=\"btn-row\">\n        <button class=\"device-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"doBuzzerOn()\">Bật</button>\n        <button class=\"device-btn off-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"doBuzzerOff()\">Tắt</button>\n      </div>\n    </div>\n    <div class=\"device-line\">\n      <span class=\"icon\">🔌</span><span class=\"label\">Relay</span>\n      <span class=\"badge\" ng-class=\"device.relay ? 'on' : 'off'\">{{ device.relay ? 'ON' : 'OFF' }}</span>\n      <div class=\"btn-row\">\n        <button class=\"device-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"doRelayOn()\">Bật</button>\n        <button class=\"device-btn off-btn\" ng-disabled=\"mode!=='manual'\" ng-click=\"doRelayOff()\">Tắt</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"charts-row\">\n    <div class=\"card chart-card\">\n      <div class=\"chart-head\">\n        <span><span class=\"legend-dot\" style=\"background:#E53935\"></span>Nhiệt độ (°C)</span>\n        <span ng-if=\"tempMin !== null\">{{ tempMin.toFixed(1) }} - {{ tempMax.toFixed(1) }}</span>\n      </div>\n      <div class=\"chart-wrap\">\n        <svg class=\"chart\">\n          <line ng-repeat=\"g in tempGrid\" ng-attr-x1=\"36\" ng-attr-y1=\"{{g.y}}\" ng-attr-x2=\"{{chartWidth-10}}\" ng-attr-y2=\"{{g.y}}\" stroke=\"#EEE\" stroke-width=\"1\"></line>\n          <text ng-repeat=\"g in tempGrid\" x=\"2\" ng-attr-y=\"{{g.textY}}\" font-size=\"10\" fill=\"#999\">{{ g.label }}</text>\n          <polyline ng-attr-points=\"{{ tempPolyline }}\" fill=\"none\" stroke=\"#E53935\" stroke-width=\"2\"></polyline>\n          <circle ng-repeat=\"p in tempPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"8\" fill=\"transparent\" style=\"cursor:pointer\" data-chart-key=\"temp\" ng-attr-data-chart-idx=\"{{$index}}\"></circle>\n          <circle ng-repeat=\"p in tempPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"2.5\" fill=\"#E53935\" style=\"pointer-events:none\"></circle>\n          <line ng-if=\"selected.temp\" ng-attr-x1=\"{{selected.temp.x}}\" ng-attr-y1=\"{{selected.temp.y}}\" ng-attr-x2=\"{{selected.temp.x}}\" ng-attr-y2=\"{{chartHeight-12}}\" stroke=\"#E53935\" stroke-width=\"1\" stroke-dasharray=\"3,3\" style=\"pointer-events:none\"></line>\n          <circle ng-if=\"selected.temp\" ng-attr-cx=\"{{selected.temp.x}}\" ng-attr-cy=\"{{selected.temp.y}}\" r=\"5.5\" fill=\"#E53935\" stroke=\"#fff\" stroke-width=\"2\" style=\"pointer-events:none\"></circle>\n        </svg>\n        <div class=\"chart-tooltip\" ng-if=\"selected.temp\"\n             ng-style=\"{left: tooltipLeft(selected.temp) + 'px', top: tooltipTop(selected.temp) + 'px'}\">\n          {{ selected.temp.value.toFixed(1) }}°C · {{ selected.temp.time }}\n        </div>\n        <div class=\"chart-hint\" ng-if=\"history.length>0 && !selected.temp\">Bấm vào 1 điểm để xem giá trị</div>\n        <div ng-if=\"history.length===0\" style=\"text-align:center;color:#999;\">Chưa có dữ liệu</div>\n      </div>\n      <div class=\"chart-axis\" ng-if=\"history.length>0\"><span>{{ chartFirstTime }}</span><span>{{ chartLastTime }}</span></div>\n    </div>\n\n    <div class=\"card chart-card\">\n      <div class=\"chart-head\">\n        <span><span class=\"legend-dot\" style=\"background:#1E88E5\"></span>Độ ẩm (%)</span>\n        <span ng-if=\"humiMin !== null\">{{ humiMin.toFixed(1) }} - {{ humiMax.toFixed(1) }}</span>\n      </div>\n      <div class=\"chart-wrap\">\n        <svg class=\"chart\">\n          <line ng-repeat=\"g in humiGrid\" ng-attr-x1=\"36\" ng-attr-y1=\"{{g.y}}\" ng-attr-x2=\"{{chartWidth-10}}\" ng-attr-y2=\"{{g.y}}\" stroke=\"#EEE\" stroke-width=\"1\"></line>\n          <text ng-repeat=\"g in humiGrid\" x=\"2\" ng-attr-y=\"{{g.textY}}\" font-size=\"10\" fill=\"#999\">{{ g.label }}</text>\n          <polyline ng-attr-points=\"{{ humiPolyline }}\" fill=\"none\" stroke=\"#1E88E5\" stroke-width=\"2\"></polyline>\n          <circle ng-repeat=\"p in humiPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"8\" fill=\"transparent\" style=\"cursor:pointer\" data-chart-key=\"humi\" ng-attr-data-chart-idx=\"{{$index}}\"></circle>\n          <circle ng-repeat=\"p in humiPoints\" ng-attr-cx=\"{{p.x}}\" ng-attr-cy=\"{{p.y}}\" r=\"2.5\" fill=\"#1E88E5\" style=\"pointer-events:none\"></circle>\n          <line ng-if=\"selected.humi\" ng-attr-x1=\"{{selected.humi.x}}\" ng-attr-y1=\"{{selected.humi.y}}\" ng-attr-x2=\"{{selected.humi.x}}\" ng-attr-y2=\"{{chartHeight-12}}\" stroke=\"#1E88E5\" stroke-width=\"1\" stroke-dasharray=\"3,3\" style=\"pointer-events:none\"></line>\n          <circle ng-if=\"selected.humi\" ng-attr-cx=\"{{selected.humi.x}}\" ng-attr-cy=\"{{selected.humi.y}}\" r=\"5.5\" fill=\"#1E88E5\" stroke=\"#fff\" stroke-width=\"2\" style=\"pointer-events:none\"></circle>\n        </svg>\n        <div class=\"chart-tooltip\" ng-if=\"selected.humi\"\n             ng-style=\"{left: tooltipLeft(selected.humi) + 'px', top: tooltipTop(selected.humi) + 'px'}\">\n          {{ selected.humi.value.toFixed(1) }}% · {{ selected.humi.time }}\n        </div>\n        <div class=\"chart-hint\" ng-if=\"history.length>0 && !selected.humi\">Bấm vào 1 điểm để xem giá trị</div>\n        <div ng-if=\"history.length===0\" style=\"text-align:center;color:#999;\">Chưa có dữ liệu</div>\n      </div>\n      <div class=\"chart-axis\" ng-if=\"history.length>0\"><span>{{ chartFirstTime }}</span><span>{{ chartLastTime }}</span></div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(scope) {\n  scope.mode = 'auto';\n  scope.modeUpdatedAt = null;\n  scope.device = { led: false, buzzer: false, relay: false };\n  scope.latest = { temp: null, humi: null, voltage: null, distance: null, updatedAt: null };\n  scope.history = [];\n  // Kich thuoc thuc te (pixel) cua khung ve - do lai tu DOM, xem measureChart()\n  scope.chartWidth = 800;\n  scope.chartHeight = 160;\n  scope.tempPolyline = ''; scope.humiPolyline = '';\n  scope.tempMin = null; scope.tempMax = null;\n  scope.humiMin = null; scope.humiMax = null;\n  scope.tempPoints = []; scope.humiPoints = [];\n  scope.tempGrid = []; scope.humiGrid = [];\n  scope.selected = { temp: null, humi: null };\n  scope.chartFirstTime = ''; scope.chartLastTime = '';\n  scope.clockStr = '';\n  scope.dateStr = '';\n\n  // ================== 8 nut dieu khien - moi nut mot topic rieng ==========\n  // Node-RED (switch node) doc msg.topic de quyet dinh dung MQTT hay HTTP\n  // theo dung bang phan chia giao thuc trong README (khong hien nhan tren\n  // giao dien Web - minh chung giao thuc xem truc tiep tren cac khoi cua\n  // flow Node-RED).\n  scope.doAuto = function() {\n    scope.mode = 'auto'; // phan hoi lac quan, se duoc xac nhan lai qua http_data\n    scope.send({ topic: 'auto', payload: 0 });\n  };\n  scope.doManual = function() {\n    scope.mode = 'manual';\n    scope.send({ topic: 'manual', payload: 1 });\n  };\n  scope.doLedOn = function() {\n    if (scope.mode !== 'manual') return;\n    scope.device.led = true;\n    scope.send({ topic: 'led_on', payload: 1 });\n  };\n  scope.doLedOff = function() {\n    if (scope.mode !== 'manual') return;\n    scope.device.led = false;\n    scope.send({ topic: 'led_off', payload: 0 });\n  };\n  scope.doBuzzerOn = function() {\n    if (scope.mode !== 'manual') return;\n    scope.device.buzzer = true;\n    scope.send({ topic: 'buzzer_on', payload: 1 });\n  };\n  scope.doBuzzerOff = function() {\n    if (scope.mode !== 'manual') return;\n    scope.device.buzzer = false;\n    scope.send({ topic: 'buzzer_off', payload: 0 });\n  };\n  scope.doRelayOn = function() {\n    if (scope.mode !== 'manual') return;\n    scope.device.relay = true;\n    scope.send({ topic: 'relay_on', payload: 1 });\n  };\n  scope.doRelayOff = function() {\n    if (scope.mode !== 'manual') return;\n    scope.device.relay = false;\n    scope.send({ topic: 'relay_off', payload: 0 });\n  };\n\n  scope.selectPoint = function(key, p) {\n    // Bam lai dung diem dang chon thi bo chon (an tooltip di)\n    var cur = scope.selected[key];\n    scope.selected[key] = (cur && cur.x === p.x && cur.y === p.y) ? null : p;\n  };\n\n  // Dat tooltip ngay canh diem vua bam, tu day sang trai/phai/xuong duoi\n  // neu diem nam sat mep khung ve.\n  var TOOLTIP_W = 118;\n  scope.tooltipLeft = function(p) {\n    var left = parseFloat(p.x) - TOOLTIP_W / 2;\n    if (left < 0) left = 0;\n    if (left + TOOLTIP_W > scope.chartWidth) left = scope.chartWidth - TOOLTIP_W;\n    return Math.round(left);\n  };\n  scope.tooltipTop = function(p) {\n    var y = parseFloat(p.y);\n    var top = y - 26;              // mac dinh dat phia tren diem\n    if (top < 0) top = y + 12;     // diem sat mep tren -> dat xuong duoi\n    return Math.round(top);\n  };\n\n  // LUU Y: khong dung ng-click tren cac diem SVG vi AngularJS Material\n  // (dashboard nay dang dung) xung dot voi module ngTouch, khien ng-click\n  // tren phan tu SVG khong kich hoat duoc. Bat click bang addEventListener\n  // native + uy quyen (delegation) tren #bk-root - phan tu goc nay luon\n  // ton tai xuyen suot cac lan ve lai bieu do.\n  var root = document.getElementById('bk-root');\n  if (root) {\n    root.addEventListener('click', function(ev) {\n      var t = ev.target;\n      if (!t || t.tagName !== 'circle') return;\n      var key = t.getAttribute('data-chart-key');\n      if (!key) return;\n      var idx = parseInt(t.getAttribute('data-chart-idx'), 10);\n      var arr = key === 'temp' ? scope.tempPoints : scope.humiPoints;\n      var p = arr && arr[idx];\n      if (!p) return;\n      scope.$apply(function() { scope.selectPoint(key, p); });\n    });\n  }\n\n  var lastModeMsgTime = 0;\n  scope.modeUpdatedRecently = function() {\n    return (Date.now() - lastModeMsgTime) < 20000;\n  };\n\n  function tick() {\n    var now = new Date();\n    scope.clockStr = now.toLocaleTimeString('vi-VN', { hour12: false });\n    scope.dateStr = now.toLocaleDateString('vi-VN');\n  }\n  tick();\n  setInterval(function() { scope.$apply(tick); }, 1000);\n\n  // SVG CO Y KHONG dat viewBox: he toa do cua no chinh la pixel that cua\n  // khung chua, nen chu tren truc Y khong bao gio bi keo gian/meo (truoc day\n  // dung viewBox co dinh 800x160 + preserveAspectRatio=\"none\" khien chu bi\n  // phong to theo chieu doc khi khung cao len). Doi lai phai tu do kich\n  // thuoc khung va ve lai moi khi kich thuoc thay doi.\n  function measureChart() {\n    var wrap = document.querySelector('#bk-root .chart-wrap');\n    if (!wrap) return false;\n    var w = Math.round(wrap.clientWidth), h = Math.round(wrap.clientHeight);\n    if (!w || !h) return false;\n    if (w === scope.chartWidth && h === scope.chartHeight) return false;\n    scope.chartWidth = w;\n    scope.chartHeight = h;\n    return true;\n  }\n\n  // Moi duong (nhiet do / do am) co bieu do RIENG, tu chuan hoa theo\n  // min-max CUA CHINH NO. Tra ve them danh sach diem {x,y,value,time} de\n  // nguoi dung bam vao xem gia tri cu the, va 3 moc luoi de doc truc gia\n  // tri ma khong can bam.\n  function buildSeries(values, times) {\n    var w = scope.chartWidth, h = scope.chartHeight;\n    var padTop = 12, padBottom = 12, padLeft = 36, padRight = 10;\n    var plotW = w - padLeft - padRight, plotH = h - padTop - padBottom;\n    var idxs = [], vals = [];\n    for (var i = 0; i < values.length; i++) {\n      if (values[i] !== null && values[i] !== undefined) { idxs.push(i); vals.push(values[i]); }\n    }\n    if (vals.length === 0) return { points: '', min: null, max: null, pts: [], grid: [] };\n    var min = Math.min.apply(null, vals), max = Math.max.apply(null, vals);\n    if (min === max) { min -= 1; max += 1; } // tranh chia cho 0 khi chi co 1 gia tri / gia tri deu nhau\n    var range = max - min;\n    var n = values.length;\n    var pts = [];\n    var svgPts = [];\n    for (var k = 0; k < idxs.length; k++) {\n      var i2 = idxs[k], v = values[i2];\n      var x = padLeft + (n <= 1 ? 0 : (i2 / (n - 1)) * plotW);\n      var y = padTop + plotH - ((v - min) / range) * plotH;\n      pts.push({ x: x.toFixed(1), y: y.toFixed(1), value: v, time: formatChartTime(times[i2]) });\n      svgPts.push(x.toFixed(1) + ',' + y.toFixed(1));\n    }\n    var grid = [];\n    [min, (min + max) / 2, max].forEach(function(v) {\n      var y = padTop + plotH - ((v - min) / range) * plotH;\n      grid.push({ y: y.toFixed(1), textY: (y + 3.5).toFixed(1), label: v.toFixed(1) });\n    });\n    return { points: svgPts.join(' '), min: min, max: max, pts: pts, grid: grid };\n  }\n\n  function formatChartTime(iso) {\n    if (!iso) return '';\n    try { return new Date(iso).toLocaleTimeString('vi-VN', { hour12: false }); }\n    catch (e) { return ''; }\n  }\n\n  function redrawChart() {\n    measureChart();\n    var times = scope.history.map(function(p) { return p.createdAt; });\n    var t = buildSeries(scope.history.map(function(p) { return p.temp; }), times);\n    var h = buildSeries(scope.history.map(function(p) { return p.humi; }), times);\n    scope.tempPolyline = t.points; scope.tempMin = t.min; scope.tempMax = t.max;\n    scope.tempPoints = t.pts; scope.tempGrid = t.grid;\n    scope.humiPolyline = h.points; scope.humiMin = h.min; scope.humiMax = h.max;\n    scope.humiPoints = h.pts; scope.humiGrid = h.grid;\n    if (scope.history.length > 0) {\n      scope.chartFirstTime = formatChartTime(scope.history[0].createdAt);\n      scope.chartLastTime = formatChartTime(scope.history[scope.history.length - 1].createdAt);\n    }\n    // Sau khi ve lai, toa do cu khong con dung nua -> tim lai dung diem da\n    // chon theo moc thoi gian de tooltip khong bi mat moi 15s (neu diem do\n    // da troi ra khoi khung du lieu thi moi bo chon).\n    reselectByTime('temp', t.pts);\n    reselectByTime('humi', h.pts);\n  }\n\n  function reselectByTime(key, pts) {\n    var prev = scope.selected[key];\n    if (!prev) return;\n    for (var i = 0; i < pts.length; i++) {\n      if (pts[i].time === prev.time && pts[i].value === prev.value) {\n        scope.selected[key] = pts[i];\n        return;\n      }\n    }\n    scope.selected[key] = null;\n  }\n\n  // Do kich thuoc khung ve ngay khi layout on dinh (vai nhip dau tien khung\n  // co the con bang 0 vi Angular chua render xong), va do lai moi khi doi\n  // kich thuoc man hinh / xoay ngang-doc dien thoai.\n  var settleTries = 0;\n  var settleTimer = setInterval(function() {\n    settleTries++;\n    if (measureChart()) scope.$apply(redrawChart);\n    if (settleTries >= 10) clearInterval(settleTimer);\n  }, 200);\n\n  var resizeTimer = null;\n  window.addEventListener('resize', function() {\n    clearTimeout(resizeTimer);\n    resizeTimer = setTimeout(function() {\n      if (measureChart()) scope.$apply(redrawChart);\n    }, 150);\n  });\n\n  scope.$watch('msg', function(msg) {\n    if (!msg || !msg.payload) return;\n    var p = msg.payload;\n    if (p.type === 'http_data') {\n      scope.history = p.history || [];\n      scope.latest = p.latest || scope.latest;\n      scope.device = p.deviceState || scope.device;\n      scope.mode = p.mode || scope.mode;\n      redrawChart();\n    }\n  });\n})(scope);\n</script>\n",
    "storeOutMessages": true,
