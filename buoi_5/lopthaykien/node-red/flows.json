  {
    "id": "n_fn_prep_mqtt_cmd",
    "type": "function",
    "z": "bk5_flow",
    "name": "Chuan bi lenh MQTT (Auto/Manual/LED Bat/Buzzer Bat)",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_CHANNEL_ID = \"DIEN_CHANNEL_ID_CUA_BAN\";\n// field6 = Che do (0=Auto,1=Manual), field5 = LED, field8 = Buzzer\nconst TOPIC_MAP = {\n  auto:       { field: 'field6', value: '0' },\n  manual:     { field: 'field6', value: '1' },\n  led_on:     { field: 'field5', value: '1' },\n  buzzer_on:  { field: 'field8', value: '1' },\n};\n// ===========================================================================\nconst cfg = TOPIC_MAP[msg.topic];\nif (!cfg) { node.warn('Topic MQTT khong hop le: ' + msg.topic); return null; }\nmsg.topic = `channels/${THINGSPEAK_CHANNEL_ID}/publish/fields/${cfg.field}`;\nmsg.payload = cfg.value;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_mqtt_out_cmd"
      ]
    ]
  },
  {
    "id": "n_mqtt_out_cmd",
    "type": "mqtt out",
    "z": "bk5_flow",
    "name": "MQTT publish (Auto/Manual/LED Bat/Buzzer Bat)",
    "topic": "",
    "qos": "1",
    "retain": "true",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "bk5_mqtt_broker",
    "wires": []
  },
  {
    "id": "n_fn_prep_http_cmd",
    "type": "function",
    "z": "bk5_flow",
    "name": "Chuan bi lenh HTTP (LED Tat/Buzzer Tat/Relay Bat/Tat)",
    "func": "// ================== CAU HINH - DIEN THAT TRUOC KHI DUNG ==================\nconst THINGSPEAK_WRITE_API_KEY = \"DIEN_WRITE_API_KEY_CUA_BAN\";\n// field5 = LED, field7 = Relay, field8 = Buzzer\nconst TOPIC_MAP = {\n  led_off:    { field: 'field5', value: '0' },\n  buzzer_off: { field: 'field8', value: '0' },\n  relay_on:   { field: 'field7', value: '1' },\n  relay_off:  { field: 'field7', value: '0' },\n};\n// ===========================================================================\nconst cfg = TOPIC_MAP[msg.topic];\nif (!cfg) { node.warn('Topic HTTP khong hop le: ' + msg.topic); return null; }\n\nmsg.url = 'https://api.thingspeak.com/update.json';\nmsg.method = 'POST';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = { api_key: THINGSPEAK_WRITE_API_KEY, [cfg.field]: cfg.value };\nmsg.attempt = 1;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "n_http_device_cmd"
      ]
    ]
  },
  {
    "id": "n_http_device_cmd",
    "type": "http request",
    "z": "bk5_flow",
    "name": "POST update.json (lenh HTTP)",
