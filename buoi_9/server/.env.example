# =========================================================================
# MAU CAU HINH SERVER BUOI 9 - copy file nay thanh .env roi dien gia tri that
#
#     cp .env.example .env
#
# File .env da bi .gitignore chan (dong '.env*') nen khong bao gio len
# GitHub.
# =========================================================================

# -------------------------------------------------------------------------
# MONGODB ATLAS (bat buoc) - dung LAI connection string cua buoi_8 cung
# duoc, chi can doi ten database/collection ben duoi de khong lan du lieu.
# Xem huong dan lay chuoi nay trong buoi_8/HUONG_DAN_ATLAS.md.
# -------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority

# -------------------------------------------------------------------------
# TUY CHON - co gia tri mac dinh san, khong dien cung chay duoc
# -------------------------------------------------------------------------
MONGODB_DB=iot_buoi9
MONGODB_COLLECTION=du_lieu_mqtt

# Broker MQTT (EMQX) chay tren may nay - xem huong dan cai dat trong
# README.md. Neu broker chay may khac thi doi MQTT_HOST.
MQTT_HOST=localhost
MQTT_PORT=1883
